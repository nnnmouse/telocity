{
  "indextranslate": {
    "reasoningType": "instruct_only",
    "metadata": {
      "helptext_key": "models.instruct",
      "display": true,
      "localJSONL": true,
      "stripEmpty": true,
      "markdownBrainRot": true,
      "forceStream": false,
      "substitutionPrefix": "CN"
    },
    "default": {
      "prompt": {
        "defPrep": [
          true,
          "请将以下{{ .LanguageSource }}文本翻译为{{ .LanguageTarget }}，直接输出翻译结果，不要进行任何解释。\n\n{{ .TextToInject }}",
          "user"
        ]
      },
      "model": {
        "chunkSize": 30,
        "batchSize": 32,
        "parallel": 4,
        "rpm": 1000,
        "maxAttempts": 3,
        "maxFail": 50,
        "tempValues": [0.4, 0.7],
        "temperature": [true, 0],
        "top_k": [true, 20],
        "top_p": [true, 0.8],
        "hardTimeout": 2,
        "model": [true, "index2b"],
        "chat_template_kwargs": [
          true,
          {
            "enable_thinking": false
          }
        ],
        "grammar": [
          true,
          "root ::= char+\nchar ::= latin9 | cjk-punct\nlatin9 ::= [\\u0020-\\u007E\\u00A0-\\u00FF\\u20AC\\t\\r\\n]\ncjk-punct ::= [\\u2000-\\u206F\\u3000-\\u303F\\uFF00-\\uFFEF]"
        ]
      }
    }
  }
}
